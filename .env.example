JWT_SECRET=
SETTINGS_ENCRYPTION_KEY=
DATA_DIR=./data

# Frontend dev server (npm run dev / scripts/start-frontend.*).
# Host names the browser may use to reach it, comma-separated, e.g. lxsplatsgv098,lxsplatsgv098.corp.local
# A leading dot allows all subdomains (.corp.local); * allows any host. localhost and IP addresses always work.
FRONTEND_ALLOWED_HOSTS=
FRONTEND_PORT=7777
# Where the dev server forwards /api calls.
BACKEND_URL=http://127.0.0.1:8000
# Optional fallbacks for the Spirare provider. Keys saved in Settings > LLM take precedence.
LLM_API_KEY=
EMBEDDING_API_KEY=
GCS_BUCKET=
GCS_DB_PATH=duckdb/solutioncrafter.duckdb

# Knowledge Base catalogs (comma-separated codes).
KB_COUNTRIES=SG,MY,TH,VN,ID
KB_DATABASES=PIB,MBK,SMS,NTN,WSM,LCM
KB_INTERFACE_CHANNELS=SPL,DGE,PIB,NTN,WSM,EAI
KB_BITBUCKET_PROJECTS=CORE,SPL,DBE,PIB,PIBVN2,PIBID,SOF,WSM,NTN

# Login IDs are plain IDs (letters and numbers, no spaces or special characters), not emails.
SEED_ADMIN_LOGIN_ID=admin
SEED_ADMIN_PASSWORD=
SEED_ANALYST_LOGIN_ID=analyst
SEED_ANALYST_PASSWORD=
SEED_VIEWER_LOGIN_ID=viewer
SEED_VIEWER_PASSWORD=

# Active Directory / LDAP. Leave LDAP_HOST empty to keep every user on a local password.
# Sign-in binds as LDAP_DOMAIN\login ID on LDAPS, then reads displayName.
LDAP_HOST=sg.uobnet.com
LDAP_PORT=636
LDAP_DOMAIN=NTSGPDOM
LDAP_BASE_DN=DC=SG,DC=UOBNET,DC=COM
LDAP_USER_FILTER=(&(objectClass=person)(sAMAccountName={login_id}))
LDAP_TLS_VALIDATE=false
LDAP_TIMEOUT_SECONDS=10
