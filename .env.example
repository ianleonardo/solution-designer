JWT_SECRET=
SETTINGS_ENCRYPTION_KEY=
DATA_DIR=./data
# Optional fallbacks for the Spirare provider. Keys saved in Settings > LLM take precedence.
LLM_API_KEY=
EMBEDDING_API_KEY=
GCS_BUCKET=
GCS_DB_PATH=duckdb/solutioncrafter.duckdb

# Knowledge Base catalogs (comma-separated codes).
KB_COUNTRIES=SG,MY,TH,VN,ID
KB_DATABASES=PIB,MBK,SMS,NTN,WSM,LCM
KB_INTERFACE_CHANNELS=SPL,DGE,PIB,NTN,WSM,EAI
KB_BITBUCKET_PROJECTS=CORE,SPL,DBE,PIB,PIBVN2,PIBID,SOF,WSM,NTN

# Login IDs are plain IDs (letters and numbers, no spaces or special characters), not emails.
SEED_ADMIN_LOGIN_ID=admin
SEED_ADMIN_PASSWORD=
SEED_ANALYST_LOGIN_ID=analyst
SEED_ANALYST_PASSWORD=
SEED_VIEWER_LOGIN_ID=viewer
SEED_VIEWER_PASSWORD=

# Active Directory / LDAP. Leave LDAP_URL empty to keep every user on a local password.
# LDAP_USER_DN binds directly, for example CN={login_id},OU=Users,DC=example,DC=com.
# Otherwise the service account searches LDAP_BASE_DN with LDAP_USER_FILTER (default sAMAccountName).
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(sAMAccountName={login_id})
LDAP_USER_DN=
LDAP_STARTTLS=false
LDAP_TIMEOUT_SECONDS=10
